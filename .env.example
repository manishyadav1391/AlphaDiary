DOMAIN=journal.example.com
# Let's Encrypt registration address, used by infra/Caddyfile. Certificate
# expiry warnings go here.
ACME_EMAIL=me@example.com
TZ=Asia/Kolkata
APP_ENV=production
APP_SECRET_KEY=change-me                 # session signing
APP_ENCRYPTION_KEY=change-me             # Fernet key for stored secrets
POSTGRES_USER=tj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tj
DATABASE_URL=postgresql+psycopg://tj:change-me@db:5432/tj
# Also decides the session cookie's Secure flag and the Kite redirect URL.
# For local development set this to http://localhost:3000, or the browser
# will drop the Secure cookie over plain http.
PUBLIC_BASE_URL=https://journal.example.com
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=tj-data
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# Email goes through Resend's HTTPS API, not SMTP (SRS 4.1).
# Without a verified domain Resend sends from onboarding@resend.dev and will
# ONLY deliver to the address on your Resend account, so REMINDER_EMAIL_TO
# must be that address until you verify a domain of your own.
RESEND_API_KEY=change-me
RESEND_FROM=onboarding@resend.dev
REMINDER_EMAIL_TO=me@example.com
HEARTBEAT_URL=https://hc-ping.com/<uuid>
BACKUP_AGE_PUBLIC_KEY=age1...
BACKUP_RCLONE_REMOTE=r2:tj-backups
KITE_API_KEY=
KITE_API_SECRET=
# Telegram and WhatsApp credentials are entered in Settings and stored encrypted in the database.

 https://journal.example.com/api/v1/kite/callback
 https://journal.example.com/?connected=1
# Only needed when pulling prebuilt images from GHCR. No CI publishes them
# yet, so a single-host deploy builds on the server instead:
#   docker compose -f docker-compose.yml -f infra/docker-compose.build.yml up -d --build
GHCR_OWNER=
TAG=latest
