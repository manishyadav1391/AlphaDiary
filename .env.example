DOMAIN=journal.example.com
TZ=Asia/Kolkata
APP_ENV=production
APP_SECRET_KEY=change-me                 # session signing
APP_ENCRYPTION_KEY=change-me             # Fernet key for stored secrets
POSTGRES_USER=tj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tj
DATABASE_URL=postgresql+psycopg://tj:change-me@db:5432/tj
# Also decides the session cookie's Secure flag and the Kite redirect URL.
# For local development set this to http://localhost:3000, or the browser
# will drop the Secure cookie over plain http.
PUBLIC_BASE_URL=https://journal.example.com
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=tj-data
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=journal@example.com
REMINDER_EMAIL_TO=me@example.com
HEARTBEAT_URL=https://hc-ping.com/<uuid>
BACKUP_AGE_PUBLIC_KEY=age1...
BACKUP_RCLONE_REMOTE=r2:tj-backups
KITE_API_KEY=
KITE_API_SECRET=
# Telegram and WhatsApp credentials are entered in Settings and stored encrypted in the database.

 https://journal.example.com/api/v1/kite/callback
 https://journal.example.com/?connected=1